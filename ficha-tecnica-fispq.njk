  </div>
</section>

<!-- ══════════════ 03 · 16 SEÇÕES ══════════════ -->
<section class="section" data-screen-label="FISPQ · 16 seções">
  <div class="container">
    <div class="section-head">
      <span class="section-num reveal-up">03 · O que tem dentro da FISPQ</span>
      <h2 class="h-display">16 seções obrigatórias da ABNT NBR 14725.</h2>
    </div>
    <div class="table-wrap reveal-up">
      <table class="tbl">
        <thead><tr><th style="width:48px">#</th><th>Seção</th><th>Cobertura</th></tr></thead>
        <tbody>
          <tr><td>01</td><td><strong>Identificação do produto</strong></td><td>Nome comercial, part number, fabricante, distribuidor, uso recomendado</td></tr>
          <tr><td>02</td><td><strong>Identificação de perigos</strong></td><td>Classificação GHS, frases H, frases P, pictogramas</td></tr>
          <tr><td>03</td><td><strong>Composição e ingredientes</strong></td><td>Componentes, nº CAS, concentração, risco</td></tr>
          <tr><td>04</td><td><strong>Primeiros socorros</strong></td><td>Inalação, pele, olhos, ingestão</td></tr>
          <tr><td>05</td><td><strong>Combate a incêndio</strong></td><td>Meios de extinção, perigos da combustão, EPI da brigada</td></tr>
          <tr><td>06</td><td><strong>Vazamento acidental</strong></td><td>Precauções, contenção e limpeza</td></tr>
          <tr><td>07</td><td><strong>Manuseio e armazenamento</strong></td><td>Manipulação, armazenagem e compatibilidade</td></tr>
          <tr><td>08</td><td><strong>Controle de exposição / EPI</strong></td><td>NR-15, EPI respiratório, dérmico e ocular</td></tr>
          <tr><td>09</td><td><strong>Propriedades físico-químicas</strong></td><td>Aspecto, pH, ponto de fulgor, viscosidade, densidade</td></tr>
          <tr><td>10</td><td><strong>Estabilidade e reatividade</strong></td><td>Condições a evitar, materiais incompatíveis, decomposição</td></tr>
          <tr><td>11</td><td><strong>Informações toxicológicas</strong></td><td>Toxicidade aguda, irritação, sensibilização, carcinogenicidade</td></tr>
          <tr><td>12</td><td><strong>Informações ecológicas</strong></td><td>Toxicidade aquática, persistência, bioacumulação</td></tr>
          <tr><td>13</td><td><strong>Destinação final</strong></td><td>Resíduos e embalagem</td></tr>
          <tr><td>14</td><td><strong>Transporte</strong></td><td>Classificação ONU, número UN, grupo de embalagem (ADR)</td></tr>
          <tr><td>15</td><td><strong>Regulamentações</strong></td><td>Normas aplicáveis, registros, restrições legais</td></tr>
          <tr><td>16</td><td><strong>Outras informações</strong></td><td>Data de revisão, legendas, referências</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

