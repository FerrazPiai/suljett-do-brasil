{#
  Layout base das PÁGINAS INTERNAS (Eleventy + Nunjucks).
  Chrome (header/footer) renderizado no build, fonte única em partials/.
  Frontmatter de cada página: title, description, activeNav e, nas
  páginas de produto, `product` (vira o evento product_view).
#}<!doctype html>
<html lang="pt-BR" data-theme="light">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>{{ title }}</title>
<meta name="description" content="{{ description }}" />
{% include "partials/head-meta.njk" %}
<link rel="preload" href="/assets/Manrope/Manrope-Variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/assets/site.css" />
</head>
<body data-page="{{ activeNav }}" data-lead-endpoint="{{ site.leadEndpoint }}" data-fichas="{{ fichas | join(',') }}"{% if product %} data-product="{{ product }}"{% endif %}>
{% include "partials/header.njk" %}
<main id="conteudo">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="/assets/site.js"></script>
<script src="/assets/leads.js"></script>
</body>
</html>
