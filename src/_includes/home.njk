{#
  Layout da HOME (Eleventy + Nunjucks).
  Chrome único (partials/), CSS inline (src/_data/home.js) e o mesmo
  assets/site.js + assets/leads.js das internas. Sem GSAP/Lenis: os
  reveals são CSS (animação ligada à rolagem, com fallback visível).
#}<!doctype html>
<html lang="pt-BR" data-theme="light">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<title>{{ title }}</title>
<meta name="description" content="{{ description }}" />
{% include "partials/head-meta.njk" %}
<link rel="preload" href="/assets/Manrope/Manrope-Variable.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/assets/hero-bg-linha.webp" as="image" type="image/webp" fetchpriority="high" />
<style>{{ home.css | safe }}</style>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "{{ site.name }}",
  "url": "{{ site.url }}/",
  "logo": "{{ site.url }}/assets/logo-suljett.png",
  "email": "contato@suljett.com",
  "telephone": "+55 51 98037-0198",
  "foundingDate": "2008",
  "sameAs": ["https://www.linkedin.com/company/suljett-do-brasil"],
  "address": [
    { "@type": "PostalAddress", "streetAddress": "Estr. João Passuelo, 342", "addressLocality": "Porto Alegre", "addressRegion": "RS", "postalCode": "91740-550", "addressCountry": "BR" },
    { "@type": "PostalAddress", "streetAddress": "R. Dona Francisca, 4808", "addressLocality": "Joinville", "addressRegion": "SC", "postalCode": "89218-112", "addressCountry": "BR" },
    { "@type": "PostalAddress", "streetAddress": "Rod. Dr. Ib Gatto M. Falcão, 500", "addressLocality": "Marechal Deodoro", "addressRegion": "AL", "postalCode": "57160-000", "addressCountry": "BR" }
  ]
}
</script>
</head>
<body data-page="home" data-lead-endpoint="{{ site.leadEndpoint }}" data-fichas="{{ fichas | join(',') }}">
{% include "partials/header.njk" %}
<main id="conteudo">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
<script src="/assets/site.js"></script>
<script src="/assets/leads.js"></script>
<script>{{ home.uiJs | safe }}</script>
</body>
</html>
